# Skopiuj jako .env i dostosuj wartosci.
# cp env.example .env
#
# Tylko wartosci zalezne od srodowiska uruchomieniowego trzymamy w .env.
# Parametry strojeniowe (szachownica, geometria, progi pipeline) sa
# stalymi w config.py.

# ── Sciezki ─────────────────────────────────────────────────
# Docker: /app/data/calib  |  lokalne testy: ./calib_images
CALIBRATION_DIR=/app/data/calib
CALIBRATION_OUTPUT=/app/data/calib_output

# ── Serwer ───────────────────────────────────────────────────
BACKEND_PORT=8000
