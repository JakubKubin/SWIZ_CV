# Skopiuj jako .env i dostosuj wartości.
# cp env.example .env

# ── Kalibracja ──────────────────────────────────────────────
CHECKERBOARD_ROWS=9
CHECKERBOARD_COLS=6
SQUARE_SIZE_MM=25.0

# ── Ścieżki ─────────────────────────────────────────────────
# Docker: /app/data/calib  |  lokalne testy: ./calib_images
CALIBRATION_DIR=/app/data/calib
CALIBRATION_OUTPUT=/app/data/calib_output

# ── Serwer ───────────────────────────────────────────────────
BACKEND_PORT=8000
